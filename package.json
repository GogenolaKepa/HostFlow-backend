{
  "name": "hostflow-backend",
  "version": "1.0.0",
  "description": "Backend para HostFlow",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:inbound": "node scripts/testInbound.js",
    "test:channels": "node scripts/testChannelOperations.js",
    "test:properties": "node scripts/testProperties.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:permissions": "node --test tests/authorization.test.js tests/flowia-permissions.test.js",
    "test:security": "node --test tests/security-*.test.js",
    "test": "node --test tests/*.test.js",
    "admin:bootstrap": "node scripts/bootstrapAdministrador.js",
    "test:sql": "node --test tests/integration/sql-seguridad.test.js",
    "test:sql:configuracion": "node --test tests/integration/sql-configuracion.test.js",
    "test:sql:check": "node scripts/comprobarSQLLocal.js --read-only",
    "dev:azure": "node scripts/devAzure.js"
  },
  "keywords": [],
  "author": "Kepa Gogenola",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "msql": "^1.0.3",
    "mssql": "12.7.5",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "msnodesqlv8": "5.6.0",
    "nodemon": "^3.1.9"
  }
}
